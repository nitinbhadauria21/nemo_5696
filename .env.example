# App — use your production HTTPS URL when deploying (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# Supabase (required for production auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Local/MVP: true. Production: set false and configure Auth SMTP / email templates
SUPABASE_AUTO_CONFIRM=true

# Ingestion cron (x-cron-secret or Authorization: Bearer)
CRON_SECRET=change-me-in-production

# Admin master code (required — no hardcoded default in app)
ADMIN_MASTER_CODE=change-me-admin-code

# AI providers
AI_PROVIDER=ANTHROPIC
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Collectors
YOUTUBE_API_KEY=
GOOGLE_TRENDS_PROXY_URL=
INSTAGRAM_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=

# OAuth social connect (required for real connect — no stub fallback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_CLIENT_ID=

# Razorpay (optional until payments go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
