# App — use your production HTTPS URL when deploying (no trailing slash)

NEXT_PUBLIC_SITE_URL=http://localhost:4028

# Supabase (required for production auth + persistence)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Prefer publishable key (sb_publishable_...) or legacy anon JWT

NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Prefer secret key (sb_secret_...) or legacy service_role JWT — server only

SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Local only: set true to auto-confirm signup. On Vercel/production defaults to false.

SUPABASE_AUTO_CONFIRM=false

# Local offline demo login (never enable on Vercel)

NEXT_PUBLIC_ALLOW_DEMO_AUTH=false
ALLOW_DEMO_AUTH=false

# Ingestion cron (required on Vercel). Send as x-cron-secret or Authorization: Bearer

CRON_SECRET=change-me-in-production

# Admin: authenticated user email that may receive is_admin (optional bootstrap).

# After the user signs up, promote them in Supabase SQL (see scripts/bootstrap-admin.sql):

# UPDATE public.profiles SET is_admin = true WHERE email = 'you@example.com';

ADMIN_EMAIL=nitin.bhadauria23@gmail.com

# Demo mode banner (never mix demo into prod live rows)

NEXT_PUBLIC_DEMO_MODE=false

# Optional: enable service worker in local/dev

NEXT_PUBLIC_ENABLE_SW=false

# Provider poll intervals (minutes) — GHA triggers every 30m; per-provider config in data_source_status

PROVIDER_POLL_INTERVAL_MINUTES=30

# AI providers (server only) — Viral Script Writer, AI chat, trend analysis/ideas/sentiment

# Default: OPENROUTER free models (server picks model per task). Leave AI_MODEL empty for auto.

# Optional local-only stub (ignored when NODE_ENV=production): AI_DEV_STUB=1

AI_PROVIDER=OPENROUTER
AI_MODEL=

# Speed: enable ultra-cheap paid twins when free models queue/rate-limit (recommended for snappy UX)

OPENROUTER_ALLOW_PAID_FALLBACK=true

# Optional per-model timeout ms (default 35000)

# OPENROUTER_REQUEST_TIMEOUT_MS=35000

OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# AI_DEV_STUB=1

# OAuth Social Connect (per-user — NOT the same as trend collector keys)

# Required to finish Connect: client id + secret per provider, plus encryption key

CONNECTIONS_ENCRYPTION_KEY=

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Trend collectors (app-level cron — fills dashboard Trends)

# Reddit OAuth (free app-only auth) — required for production; public .json fallback in local dev
# 1. Go to https://www.reddit.com/prefs/apps → create app (type: script or web app)
# 2. Add REDDIT_CLIENT_ID + REDDIT_CLIENT_SECRET to Vercel → Redeploy
# Without these, Reddit will show as Unavailable in production.

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NemoTrends/1.2 (by /u/nemo; contact@nemo.app)

YOUTUBE_API_KEY=
SERPAPI_KEY=
SEARCHAPI_KEY=

# Alias also accepted: SEARCHAPI_API_KEY

GOOGLE_TRENDS_PROXY_URL=
GOOGLE_TRENDS_GEO=IN

# ScrapeCreators — YouTube Shorts + TikTok feed + X/Twitter (via getdaytrends) + IG reels + FB page reels

# Get a key at https://app.scrapecreators.com (send as x-api-key). Never commit the real key.

# Alias also accepted: SCRAPE_CREATORS_API_KEY

SCRAPECREATORS_API_KEY=

# TikTok trending-feed region (2-letter). Prefer IN for India-first product.

SCRAPECREATORS_TIKTOK_REGION=IN

# getdaytrends country path for X topics (india | united-states | …). Defaults from GOOGLE_TRENDS_GEO.

SCRAPECREATORS_TWITTER_GEO=india

# Comma-separated public Facebook page URLs for reel discovery (no native FB trending API)

FACEBOOK_TREND_PAGE_URLS=https://www.facebook.com/whatstrending,https://www.facebook.com/CNN
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_ACCESS_TOKEN=
TREND_STALE_MAX_AGE_HOURS=72
TWITTER_BEARER_TOKEN=

# OAuth TikTok client key (Social Connect) — not used for global TikTok trends

# TIKTOK_CLIENT_KEY is listed under OAuth above

# Razorpay (server owns prices — never trust client amounts)

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
